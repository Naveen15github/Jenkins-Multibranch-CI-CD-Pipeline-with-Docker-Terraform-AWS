# AWS Configuration
aws_region  = "us-east-1"
environment = "production"

# Project Configuration
project_name = "jenkins-cicd-pipeline"

# Network Configuration
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"

# Security Configuration
# IMPORTANT: Replace 0.0.0.0/0 with your actual IP address for production!
# Example: ["203.0.113.0/32"] for a single IP
# Example: ["203.0.113.0/24"] for a subnet
allowed_ssh_cidr     = ["0.0.0.0/0"]  # Change this to your IP!
allowed_jenkins_cidr = ["0.0.0.0/0"]  # Change this to your IP!

# SSH Key Configuration
# IMPORTANT: Provide your SSH public key here
# Generate one with: ssh-keygen -t rsa -b 4096 -f ~/.ssh/jenkins-cicd-key
# Then copy the content of ~/.ssh/jenkins-cicd-key.pub
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQC... your-email@example.com"

# EC2 Instance Types
jenkins_instance_type    = "t3.medium"  # 2 vCPU, 4 GB RAM - recommended for Jenkins
staging_instance_type    = "t3.micro"   # 2 vCPU, 1 GB RAM
production_instance_type = "t3.small"   # 2 vCPU, 2 GB RAM

# Docker Hub Configuration
docker_hub_username = "yourdockerhubusername"
docker_hub_password = "your-docker-hub-token-or-password"  # Use token for better security

# Additional Tags (optional)
additional_tags = {
  Owner      = "DevOps Team"
  CostCenter = "Engineering"
  Compliance = "Standard"
}
