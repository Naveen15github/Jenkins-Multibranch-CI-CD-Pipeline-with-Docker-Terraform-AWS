# Application
PORT=3000
NODE_ENV=development

# Docker
DOCKER_IMAGE=yourdockerhubusername/myapp
DOCKER_HUB_CREDENTIALS=DOCKER_HUB_CREDENTIALS

# Servers
STAGING_SERVER_IP=<staging-ec2-public-ip>
PROD_SERVER_IP=<prod-ec2-public-ip>
DEPLOY_USER=ec2-user

# SonarQube
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=jenkins-cicd-pipeline
SONAR_TOKEN=<sonarqube-generated-token>

# Slack
SLACK_WEBHOOK=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Jenkins Credential IDs (used inside Jenkinsfile - not actual secrets)
JENKINS_CRED_DOCKER=DOCKER_HUB_CREDENTIALS
JENKINS_CRED_SSH=SSH_KEY
JENKINS_CRED_SLACK=SLACK_WEBHOOK
JENKINS_CRED_SONAR=SONAR_TOKEN
